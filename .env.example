## Public envs (safe for browser)
NEXT_PUBLIC_APP_NAME="HRMS Web"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
## Optional: public site URL for emails / links. On Vercel, `VERCEL_URL` is used when this is empty.
NEXT_PUBLIC_APP_URL=""

## Supabase (same project as legacy HRMS app — used by `/api/*` route handlers)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
## Recommended for attendance screenshots / activity reads & attendance_state sync
## (falls back to anon key when unset — may miss agent rows if RLS is strict)
SUPABASE_SERVICE_ROLE_KEY=""

## Signed session cookie for `/api/auth/login` (generate a long random string in production)
AUTH_SECRET="change-me-in-production"

## API / Auth base URLs (placeholders — wire your backend later)
NEXT_PUBLIC_API_BASE_URL="https://api.example.com"
NEXT_PUBLIC_AUTH_BASE_URL="https://auth.example.com"

## OAuth placeholders (if enabled in `src/config/authConfig.ts`)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id"
NEXT_PUBLIC_GOOGLE_REDIRECT_URI="http://localhost:3000/auth/oauth/callback"

## Power Automate webhooks (server-side only)
# Generic email flow (expects JSON with: { toEmail, subject, body })
POWER_AUTOMATE_EMAIL_URL="https://prod-00.westus.logic.azure.com:443/workflows/.../triggers/manual/paths/invoke?api-version=..."
# Optional: validate in flow using header `x-hrms-email-secret`
POWER_AUTOMATE_EMAIL_SECRET=""

# Backward-compatible names (optional)
POWER_AUTOMATE_LEAVE_URL=""
POWER_AUTOMATE_LEAVE_SECRET=""

## Leave / reimbursement emails from mobile (POST `/api/webhooks/hrms-transaction-notify`).
## If unset, the webhook accepts unauthenticated POSTs (set a value in production).
HRMS_TRANSACTION_NOTIFY_SECRET=""
# Optional: override default hr@siyanainfo.com for “new request” HR notifications
HRMS_NOTIFY_HR_EMAIL=""

